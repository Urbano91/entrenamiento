# Supabase Session Pooler (PostgreSQL síncrono mediante psycopg2).
# Formato: postgresql+psycopg2://<usuario>:<password>@<pooler-host>:<puerto>/postgres?sslmode=require
DATABASE_URL=

# Secreto aleatorio para firmar las cookies de sesión.
SESSION_SECRET=

# Embeddings locales por defecto: reproducibles y sin servicio externo.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_DIMENSIONS=384
PRIVATE_SIMILARITY_NOTICE_THRESHOLD=0.75

# Alternativa opcional: EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
